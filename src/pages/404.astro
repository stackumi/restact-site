---
import Base from '../layouts/Base.astro';
/* Served by Cloudflare for any unknown path. The mono line shows the requested path, filled in by
   the script (the page itself is static), and reads as a failed request. */
---

<Base title="Not found" description="This page does not exist.">
  <section class="nf container">
    <p class="status mono">404 Not Found</p>
    <h1>No object at this path.</h1>
    <p class="req mono"><span class="m">GET</span> <span data-path>/</span></p>
    <p class="lede">The page you asked for does not exist or has moved. Start from the home page or read the specification.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn" href="/spec/">Specification</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(64px, 12vw, 140px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .status {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .req {
    max-width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--sunk);
    font-size: 15px;
    color: var(--ink);
    overflow-x: auto;
    white-space: nowrap;
  }
  .m {
    color: var(--signal);
    font-weight: 600;
  }
  .lede {
    max-width: 520px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>

<script>
  const el = document.querySelector('[data-path]');
  if (el) el.textContent = location.pathname;
</script>
