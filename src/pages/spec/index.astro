---
import Base from '../../layouts/Base.astro';
import { plain, DRAFT_PATH, REGISTRIES_PATH, SPECS_REPO, DRAFT_FILE, featureTokens, renderDraft, readSpec, sectionText, witSummary } from '../../lib/specmd';
import { SECTION_MAP, UNMAPPED, type Tag } from '../../lib/spec-map';
import { GITHUB } from '../../site.config';

/* The specification hub. Copy and structure follow the approved canvas (Spec.dc.html). The section
   map, the mandatory core check, the feature-token list and the WIT summary are all read from the
   vendored sources at build time (src/content/spec, scripts/sync-spec.mjs). */

const doc = renderDraft();
const f = doc.front;
const source = JSON.parse(readSpec('SOURCE.json')) as { commit: string; date: string };

// The mandatory core is the list in "Conformance and Feature Discovery". The page words it in six
// lines; fail the build if the draft's list stops saying these things.
const conformance = plain(sectionText(doc, 'conformance')).replace(/\s+/g, ' ');
for (const phrase of [
  'A conformant server MUST implement',
  'addressing grammar',
  'invocation',
  'capability confinement',
  'resource limits',
  'runs-as-caller',
  'Problem Details',
  'discovery',
]) {
  if (!conformance.includes(phrase)) throw new Error(`spec hub: the draft's conformance text no longer contains "${phrase}"`);
}
// The list itself: exactly five bullets between the lead-in and "Everything else is OPTIONAL",
// and the same words in the same order, so a sixth item or a reordering also fails the build.
const coreList = sectionText(doc, 'conformance').split('A conformant server MUST implement:')[1]?.split('Everything else is OPTIONAL')[0] ?? '';
const bullets = coreList.split('\n').filter((l) => /^\* /.test(l));
if (bullets.length !== 5) throw new Error(`spec hub: the draft's mandatory core now has ${bullets.length} bullets (the page words five); update the page`);
const order = ['addressing grammar', 'capability confinement', 'runs-as-caller', 'Problem Details', 'discovery'];
const at = order.map((w) => bullets.findIndex((b) => b.includes(w)));
if (at.some((n, i) => n < 0 || (i > 0 && n < at[i - 1]))) throw new Error('spec hub: the mandatory core bullets no longer match the page');
const core = [
  'Addressing and verb invocation',
  'Capability confinement, deny by default',
  'Per-invocation resource limits',
  'The runs-as-caller authority rule',
  'Problem Details error responses',
  'A discovery document',
];

const sections = doc.sections
  .filter((s) => s.depth === 1 && !UNMAPPED.has(s.id))
  .map((s) => {
    const m = SECTION_MAP[s.id];
    if (!m) throw new Error(`spec hub: no gist for draft section "${s.id}" (${s.title}); add it to src/lib/spec-map.ts`);
    return { ...s, ...m };
  });
// The draft's headings are Title Case; the section table follows the site's sentence case.
const KEEP = new Set(['HTTP', 'JSON:API', 'Google', 'AIP', 'IANA', 'WIT', 'REST', 'REST:ACT', 'SSE', 'OPTIONS', 'API', 'URI']);
const sentence = (t: string) =>
  t
    .split(' ')
    .map((w, i) => {
      const bare = w.replace(/^[(]|[):,]+$/g, '');
      return i === 0 || KEEP.has(bare) || /[`:.]/.test(bare) ? w : w.toLowerCase();
    })
    .join(' ');
const tagClass = (t: Tag) => ({ core: 't-core', optional: 't-opt', 'core + optional': 't-mixed', informative: 't-info', registry: 't-info' })[t];
const sectionNo = (num: string) => (/^[A-Z]/.test(num) ? `Appendix ${num}` : `§${num}`);
const status = ['Normative', f.category, f.stream.replace(' Submission', ' stream')].join(', ');

const tokens = featureTokens();
const wit = witSummary();

const documents = [
  { name: 'The Internet-Draft', href: DRAFT_PATH, status: 'Normative', covers: 'The protocol: grammar, methods, capabilities, limits, discovery' },
  {
    name: 'Presentation verbs',
    href: '/spec/presentation-verbs/',
    status: 'Normative',
    covers: 'The application/vnd.restact.ui+json media type',
    mono: true,
  },
  { name: 'Registries', href: REGISTRIES_PATH, status: 'Normative initial contents', covers: 'Feature tokens, interfaces, languages, property names, catalog nodes, LLM providers' },
  { name: 'WIT package', href: `${DRAFT_PATH}#appendix-wit`, status: 'Normative, draft appendix', covers: 'The host interfaces a verb may import' },
  { name: 'x-restact OpenAPI extension', href: `${GITHUB.restactd}/tree/main/openapi`, status: 'Companion schema', covers: 'The schema of the x-restact extension in an OpenAPI document' },
  { name: 'How it works', href: '/how-it-works/', status: 'Explanatory', covers: 'The model in prose, with diagrams' },
];
const registries = [
  ['feature-tokens', 'Feature tokens'],
  ['source-languages', 'Source languages'],
  ['capability-interfaces', 'Capability interfaces'],
  ['verb-property-names', 'Verb property names'],
  ['ui-catalog-nodes', 'UI catalog nodes'],
  ['llm-providers', 'LLM providers'],
];
---

<Base
  title="Specification"
  description="The normative text of REST:ACT is written as an individual Internet-Draft, intended category Experimental, on the independent stream. It has not yet been submitted to the IETF and is not a standard."
>
  <section class="container opening">
    <h1>Specification</h1>
    <p class="lede">
      The normative text is written as an individual Internet-Draft with intended category Experimental, on the
      independent stream. It has not yet been submitted to the IETF, and it is not a standard. The key words <span class="kw">MUST</span>, <span class="kw">SHOULD</span> and{' '}
      <span class="kw">MAY</span> are used as BCP 14 defines them (RFC 2119, RFC 8174) when they appear in capitals.
    </p>
  </section>

  <section class="container sect draft" aria-labelledby="draft-title">
    <div class="info">
      <h2 id="draft-title">{f.title}</h2>
      <dl class="rows">
        <dt>Status</dt>
        <dd>{status}</dd>
        <dt>Document</dt>
        <dd class="mono">{f.docname}</dd>
        <dt>Author</dt>
        <dd>{f.author}</dd>
        <dt>Area</dt>
        <dd>{f.area}</dd>
        <dt>Guest contract</dt>
        <dd class="mono">rest-act:plugin@0.1.0</dd>
        <dt>Rendered from</dt>
        <dd><a class="mono" href={`${SPECS_REPO}/commit/${source.commit}`}>restact-specs @ {source.commit.slice(0, 7)}</a></dd>
      </dl>
      <div class="actions">
        <a class="btn btn--primary" href={DRAFT_PATH}>Read the draft</a>
        <a class="btn" href={`${SPECS_REPO}/blob/main/${DRAFT_FILE}`}>Source on GitHub</a>
      </div>
    </div>
    <div class="mandatory">
      <h3>The mandatory core</h3>
      <p>
        A conformant server implements these and advertises everything else
        (<a href={`${DRAFT_PATH}#conformance`}>{doc.sections.find((s) => s.id === 'conformance')?.label}</a>).
      </p>
      <ul>
        {
          core.map((c) => (
            <li>
              <span class="kw">MUST</span>{' '}
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container sect" id="read" aria-labelledby="read-h">
    <h2 id="read-h">The draft, section by section</h2>
    <table class="sections">
      <thead>
        <tr><th scope="col" class="c-n">§</th><th scope="col">Section</th><th scope="col">Tag</th><th scope="col">Summary</th></tr>
      </thead>
      <tbody>
        {
          sections.map((t) => (
            <tr>
              <td class="c-n">{sectionNo(t.num)}</td>
              <th scope="row" class="c-title"><a href={`${DRAFT_PATH}#${t.id}`}>{sentence(t.title)}</a></th>
              <td class={`c-tag ${tagClass(t.tag)}`}>{t.tag}</td>
              <td class="c-gist">{t.gist}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      Tags follow <a href={`${DRAFT_PATH}#conformance`}>the conformance section</a>: core is what a conformant server
      must implement, optional is what it may implement and advertise.
    </p>
  </section>

  <section class="container sect split" id="feature-tokens" aria-labelledby="tokens-h">
    <div class="intro">
      <h2 id="tokens-h">Feature tokens</h2>
      <p>
        A server lists the optional features it supports in <span class="code-inline">service.features</span>. A client
        may rely on a behavior only when its token is advertised. Token names are permanent; a feature whose contract
        changes incompatibly takes a new token.
      </p>
      <ul class="links">
        {
          registries
            .filter(([slug]) => slug !== 'feature-tokens')
            .map(([slug, label]) => (
              <li>
                <a href={`${REGISTRIES_PATH}#${slug}`}>{label}</a>
              </li>
            ))
        }
        <li><a href={`${REGISTRIES_PATH}#feature-tokens`}>The feature token registry, with its rules</a></li>
      </ul>
    </div>
    <div class="browser" id="token-browser">
      <div class="bar">
        <label class="search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"
            ><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg
          >
          <input type="search" id="token-filter" placeholder={`Filter ${tokens.length} tokens`} aria-label="Filter feature tokens" autocomplete="off" />
        </label>
      </div>
      <div class="tokens-scroll" tabindex="0" role="region" aria-label="Feature tokens">
        <ul class="tokens" id="token-list">
          {
            tokens.map((t) => (
              <li data-q={`${t.token} ${t.plain} ${t.status}`.toLowerCase()}>
                <span class="name">{t.token}</span>
                <span class="desc" set:html={t.html} />
                <span class={`status ${t.status}`}>{t.status}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="count" id="token-count" role="status" aria-live="polite">{tokens.length} tokens</p>
    </div>
  </section>

  <section class="container sect" id="wit" aria-labelledby="wit-h">
    <h2 id="wit-h">The guest contract</h2>
    <p class="note">
      <a href={`${DRAFT_PATH}#appendix-wit`}>{doc.sections.find((s) => s.id === 'appendix-wit')?.label}</a>{' '}
      of the draft, package rest-act:plugin@0.1.0
    </p>
    <div class="witgrid">
      <div class="witcol">
        <h3>Interfaces</h3>
        <dl>
          {wit.interfaces.map((i) => (<div><dt class="mono">{i.name}</dt><dd set:html={i.html} /></div>))}
        </dl>
      </div>
      <div class="witcol">
        <h3>Worlds</h3>
        <dl>
          {wit.worlds.map((i) => (<div><dt class="mono">{i.name}</dt><dd set:html={i.html} /></div>))}
        </dl>
      </div>
    </div>
  </section>

  <section class="container sect last" id="documents" aria-labelledby="documents-h">
    <h2 id="documents-h">Every document</h2>
    <div class="tablewrap">
      <table class="docs">
        <thead>
          <tr><th scope="col">Document</th><th scope="col">Status</th><th scope="col">Covers</th></tr>
        </thead>
        <tbody>
          {
            documents.map((d) => (
              <tr>
                <th scope="row"><a href={d.href}>{d.name}</a></th>
                <td>{d.status}</td>
                <td class={d.mono ? 'mono-cell' : undefined}>{d.covers}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .opening {
    padding-block: 64px 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: clamp(32px, 3.4vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .opening .lede {
    max-width: 62ch;
  }
  .kw {
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 500;
    color: var(--ink);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .note {
    font-size: 15px;
    color: var(--ink-3);
  }
  h3 {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    letter-spacing: 0;
  }

  /* The draft: its metadata beside the mandatory core, both plain text on the page ground. */
  .draft {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px 72px;
  }
  .draft::before {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .info h2 {
    margin-bottom: 0;
  }
  .rows {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    margin: 0;
    font-size: 15px;
    border-top: 1px solid var(--hair);
  }
  .rows dt,
  .rows dd {
    padding-block: 9px;
    border-bottom: 1px solid var(--hair);
  }
  .rows dt {
    padding-right: 24px;
    color: var(--ink-3);
  }
  .rows dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }
  .mandatory {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mandatory p {
    font-size: 16px;
    color: var(--ink-2);
  }
  .mandatory li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-block: 11px;
    border-bottom: 1px solid var(--hair);
    font-size: 16px;
  }
  .mandatory li:first-child {
    border-top: 1px solid var(--hair);
  }
  .mandatory .kw {
    width: 40px;
    flex: none;
    font-size: 12px;
  }

  /* Section table: hairline rows, the title links to that section of the draft. */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  th,
  td {
    padding: 13px 24px 13px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hair);
    color: var(--ink-2);
  }
  th:last-child,
  td:last-child {
    padding-right: 0;
  }
  thead th {
    padding-block: 0 10px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  tbody th {
    font-weight: 400;
  }
  .sections {
    margin-block: 24px 20px;
    font-variant-numeric: tabular-nums;
  }
  .c-n {
    width: 7.5em;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .c-title {
    width: 30%;
  }
  .c-title a {
    font-weight: 600;
  }
  .c-tag {
    width: 9em;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .c-tag.t-core {
    color: var(--signal);
  }
  .c-tag.t-mixed {
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .sections thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .sections tbody {
      display: block;
      border-top: 1px solid var(--line);
    }
    .sections tr {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 16px;
      padding-block: 14px;
      border-bottom: 1px solid var(--hair);
    }
    .sections th,
    .sections td {
      display: block;
      width: auto;
      padding: 0;
      border: 0;
    }
    .sections .c-tag {
      justify-self: end;
    }
    .sections .c-title,
    .sections .c-gist {
      grid-column: 1 / -1;
    }
    .sections .c-n {
      grid-row: 1;
      grid-column: 1;
    }
    .sections .c-tag {
      grid-row: 1;
      grid-column: 2;
    }
  }

  /* Feature tokens: the list sits on the page ground between hairlines. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 32px 56px;
    align-items: start;
  }
  .split::before {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .intro h2 {
    margin-bottom: 0;
  }
  .intro p {
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-direction: column;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
  .bar {
    display: none;
    padding-bottom: 14px;
  }
  :global(.js) .bar {
    display: block;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink-3);
  }
  .search:focus-within {
    border-color: var(--signal);
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
  .search input {
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    width: 100%;
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .tokens-scroll {
    max-height: 640px;
    overflow-y: auto;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .tokens li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hair);
  }
  .tokens li:last-child {
    border-bottom: 0;
  }
  .tokens li[hidden] {
    display: none;
  }
  .tokens .name {
    flex: 0 0 210px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .tokens .desc {
    flex: 1 1 260px;
    min-width: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .tokens .status {
    flex: 0 0 auto;
    align-self: flex-start;
    font-size: 13px;
    color: var(--ink-3);
  }
  .tokens .status.reserved {
    color: var(--warn);
  }
  .count {
    margin: 0;
    padding-top: 12px;
    font-size: 14px;
    color: var(--ink-3);
  }
  @media (max-width: 560px) {
    .tokens .name {
      flex-basis: 100%;
    }
  }

  /* Guest contract: two plain columns of definitions. */
  .witgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 32px 56px;
    margin-top: 28px;
  }
  .witcol {
    min-width: 0;
  }
  .witcol dl {
    margin: 0;
  }
  .witcol dl > div {
    padding-block: 14px;
    border-bottom: 1px solid var(--hair);
  }
  .witcol dt {
    font-size: 13.5px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .witcol dd {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Every document: the same hairline table, scrolling inside itself on narrow screens. */
  .tablewrap {
    margin-top: 24px;
    overflow-x: auto;
  }
  .docs {
    min-width: 600px;
  }
  .mono-cell {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @media (max-width: 939px) {
    .draft,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .opening {
      padding-block: 40px 28px;
    }
    .draft::before,
    .split::before {
      margin-bottom: 0;
    }
  }
</style>

<script>
  // Filter the feature-token list. Without JavaScript the full list stays visible.
  const input = document.getElementById('token-filter') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('#token-list li'));
  const count = document.getElementById('token-count');
  if (input && count) {
    const total = items.length;
    const apply = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const li of items) {
        const q = li.dataset.q ?? '';
        const hit = words.every((w) => q.includes(w));
        li.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = words.length ? `${shown} of ${total} shown` : `${total} of ${total} shown`;
    };
    input.addEventListener('input', apply);
    apply();
  }
</script>
