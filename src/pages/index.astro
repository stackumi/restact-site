---
import Base from '../layouts/Base.astro';
import AnatomyDemo from '../components/AnatomyDemo.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ReaderGroups from '../components/ReaderGroups.astro';
import Feedback from '../components/Feedback.astro';
import { term } from '../lib/term';
import { DRAFT, GITHUB, RESTACTD_DOCS, SITE } from '../site.config';

/* The home page, written for a general technical reader first. The draft's title, the one-line
   reason for the protocol and a plain introduction open it, with one next step per reader. Then
   what the protocol is for, one object answering four requests, the rules that confine uploaded
   code, and one verb built, uploaded and called. It closes on the reader-grouped links and a note on
   comments. The page sets the tagline in its opening, so the tagline bar is off here. Copy sits up
   here, markup below. */

const DRAFT_URL = '/spec/draft/';

/* The title sets its name and subtitle on two lines, so the line break stands in for the colon after
   "Protocol" (screen readers still hear it); REST:ACT's own colon is the only one shown. */
const [titleName, titleSub] = DRAFT.title.split(': ');

const dek = {
  why: 'Let users and their agents add the functions an API doesn’t have.',
  scope: {
    protocol: { label: 'open-source protocol', href: '/spec/' },
    server: { label: 'reference server', href: '/restactd/' },
  },
};

/* Plain first, for a reader who has never met the protocol; the last paragraph names the technology
   for the reader who wants it. */
const abstract = [
  'An API can do only what its developers built into it. When you need something it lacks, you ask them and wait, or you copy the data out and do the work somewhere else.',
  'REST:ACT lets an API’s users add the missing piece themselves, within the permissions the server grants them. A user, or an agent working for them, uploads a small program called a verb. From then on, anyone the server allows can run it with an ordinary web request.',
  'Each verb is a WebAssembly component. The server runs it in a sandbox, by default with the permissions of whoever calls it, and stops it when it runs out of time or memory.',
];

/* One next step for each of the three readers, then the reference server, which all three can use.
   Each link carries the same name here and in the reader groups at the close: one name per page. */
const next = [
  { label: 'Read the draft', href: DRAFT_URL },
  { label: 'Specification overview', href: '/spec/' },
  { label: 'Get started', href: '/start/' },
  { label: 'Run the reference server', href: '/restactd/' },
];

const demo = {
  heading: 'How the server reads a request',
  lead: 'A verb’s address is the address of the thing it works on, then a colon and the verb’s name, as in notes/42:wordCount. Here are four requests to one example note, notes/42. Select one to see what the server does with it.',
};

const paths = {
  heading: 'Where to go next',
  groups: [
    {
      reader: 'Reviewing the protocol',
      links: [
        { label: 'How it works', href: '/how-it-works/', body: 'Objects, verbs and how a request finds the verb it names, step by step.' },
        { label: 'Read the draft', href: DRAFT_URL, body: 'Addressing, method semantics, capabilities, limits, authorization and security considerations.' },
        { label: 'Security model', href: '/security/', body: 'The threat model and how the draft answers it.' },
      ],
    },
    {
      reader: 'Implementing a server',
      links: [
        { label: 'Specification overview', href: '/spec/', body: 'A section-by-section map of the draft, marked core or optional.' },
        { label: 'Test a server', href: RESTACTD_DOCS.conformance, body: 'restact-conformance sends black-box tests to any server, using the features it advertises.' },
        { label: 'Run the reference server', href: '/restactd/', body: 'restactd, in Rust on Wasmtime: what it implements, its documentation and its source.' },
      ],
    },
    {
      reader: 'Writing and calling verbs',
      links: [
        { label: 'Get started', href: '/start/', body: 'Run restactd locally and deploy a first verb in JavaScript, Python or Rust.' },
        { label: 'Call verbs from an AI agent', href: GITHUB.mcp, body: 'restact mcp serves a REST:ACT host’s verbs as MCP tools.' },
        { label: 'Write verbs in Rust', href: GITHUB.sdk, body: 'restact-sdk, a Rust crate for writing verbs.' },
      ],
    },
  ],
};

const uses = {
  heading: 'What it is for',
  lead: 'Code-writing assistants have made small programs easy to write, even for people who are not programmers. Many of those programs are most useful running next to the data they work on, inside someone else’s service. For example:',
  items: [
    'A user adds a function that reshapes rows in a database.',
    'A bot adds a tool to a service it works with.',
    'A social site runs a profile owner’s code when other people interact with the profile.',
    'In a shared online world, the people in it write both the content and the programs.',
  ],
};

/* The rules that confine uploaded code, in plain words. Each links the draft section it rests on;
   the full mandatory core is on /spec/, where the build checks it against the draft. */
const core = {
  heading: 'How the server keeps uploaded code in check',
  lead: 'The draft assumes that any uploaded verb could be hostile. A server does not try to decide whether the code is safe. It confines whatever runs, under these rules.',
  items: [
    { name: 'A verb reaches only what it imports', body: 'A verb lists the server interfaces it needs, and the server refuses an upload that asks for one it does not allow. No verb gets raw network access.', href: `${DRAFT_URL}#capabilities` },
    { name: 'A verb runs as the caller', body: 'By default, a verb can do nothing the person or program calling it could not do directly, and nothing it did not declare. A server may let a verb’s owner lend it the owner’s permissions instead, and the verb’s description then says so.', href: `${DRAFT_URL}#exec-identity` },
    { name: 'Every call has limits', body: 'A call that runs past its time limit ends with HTTP status 504, and one that runs out of memory with 507. The draft also recommends a compute limit, answered with 429.', href: `${DRAFT_URL}#limits` },
    { name: 'Calls share one deadline', body: 'Where a server lets verbs call other verbs on it, they all share one deadline, so a chain of calls cannot run longer than the first call was allowed.', href: `${DRAFT_URL}#composition` },
  ],
  after: {
    before: 'The',
    spec: { label: 'specification overview', href: '/spec/' },
    middle: 'lists everything a conformant server must implement, and the',
    security: { label: 'security model', href: '/security/' },
    after: 'explains each rule.',
  },
};

const example = {
  heading: 'A verb, end to end',
  lead: 'Here is a Rust verb that counts words. It is built with cargo, uploaded with POST /v1/modules (the draft’s reference way to deploy a verb) and called with GET. The upload creates notes/42:wordCount, the function in the second request above. With authentication off, as on a local restactd, the note does not have to exist first.',
  needs: {
    server: { before: 'The commands need', link: { label: 'restactd', href: '/restactd/' }, after: 'running on localhost:8080.' },
    how: { link: { label: 'Get started', href: '/start/' }, after: 'shows how.' },
  },
  rustLabel: 'src/lib.rs',
  rust: `use restact_sdk::{export_verb, Error, ErrorExt, Payload, Verb};

struct WordCount;

impl Verb for WordCount {
    fn invoke(input: Payload) -> Result<Payload, Error> {
        let text = String::from_utf8(input)
            .map_err(|_| Error::invalid_input("input is not UTF-8"))?;
        Ok(text.split_whitespace().count().to_string().into_bytes())
    }
}

export_verb!(WordCount);`,
  shell: term(`
$ cargo build --release --target wasm32-wasip2
$ curl -X POST --data-binary @target/wasm32-wasip2/release/word_count.wasm \\
    'localhost:8080/v1/modules?verb=notes/42¦wordCount&kind=function'
$ curl 'localhost:8080/v1/notes/42¦wordCount?input=one%20two%20three'
«3»
`),
  more: { label: 'The same verb in JavaScript and Python', href: '/start/' },
};


/** Split a sentence so paths and identifiers render in monospace; the words are unchanged. */
const CODEY = /(\/[A-Za-z0-9_.\-\/:]*[A-Za-z0-9_]|notes\/42:wordCount|notes\/42|restact_code)/g;
const split = (s: string) => s.split(CODEY).map((t, i) => ({ t, code: i % 2 === 1 }));

/* Structured data: the site, under both spellings of its name. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: ['restact', 'The REST:ACT Protocol'],
  url: new URL('/', Astro.site).href,
  description: SITE.description,
  inLanguage: 'en',
};
---

<Base fullTitle={DRAFT.title} jsonLd={jsonLd} tagline={false}>
  <section class="container opening" aria-labelledby="title">
    <h1 id="title"><span class="name">{titleName}</span><span class="sr-only">: </span>{titleSub}</h1>
    <p class="dek">
      {dek.why}{' '}
      <span class="scope">
        An <a href={dek.scope.protocol.href}>{dek.scope.protocol.label}</a> and{' '}
        <a href={dek.scope.server.href}>{dek.scope.server.label}</a>.
      </span>
    </p>
    {abstract.map((p) => <p>{p}</p>)}
    <ul class="next" aria-label="Start here">
      {next.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
  </section>

  <section class="container sect" aria-labelledby="uses">
    <div class="measure">
      <h2 id="uses">{uses.heading}</h2>
      <p class="lead">{uses.lead}</p>
      <ul class="uses">
        {uses.items.map((u) => <li>{u}</li>)}
      </ul>
    </div>
  </section>

  <section class="container sect demo" aria-labelledby="demo">
    <h2 id="demo">{demo.heading}</h2>
    <p class="lead">
      {split(demo.lead).map((x) => (x.code ? <code>{x.t}</code> : x.t))}
    </p>
    <AnatomyDemo />
  </section>

  <section class="container sect" aria-labelledby="core">
    <div class="measure">
      <h2 id="core">{core.heading}</h2>
      <p class="lead">{core.lead}</p>
    </div>
    <ul class="core">
      {
        core.items.map((c) => (
          <li>
            <a href={c.href}>{c.name}</a>
            <p>{split(c.body).map((x) => (x.code ? <code>{x.t}</code> : x.t))}</p>
          </li>
        ))
      }
    </ul>
    <p class="measure core-after">
      {core.after.before} <a href={core.after.spec.href}>{core.after.spec.label}</a> {core.after.middle}{' '}
      <a href={core.after.security.href}>{core.after.security.label}</a> {core.after.after}
    </p>
  </section>

  <section class="container sect" aria-labelledby="example">
    <div class="measure">
      <h2 id="example">{example.heading}</h2>
      <p class="lead">{split(example.lead).map((x) => (x.code ? <code>{x.t}</code> : x.t))}</p>
      <p>
        {example.needs.server.before} <a href={example.needs.server.link.href}>{example.needs.server.link.label}</a>{' '}
        {example.needs.server.after} <a href={example.needs.how.link.href}>{example.needs.how.link.label}</a>{' '}
        {example.needs.how.after}
      </p>
    </div>
    <div class="codes">
      <CodeBlock lang="rust" code={example.rust} label={example.rustLabel} />
      <CodeBlock variant="terminal" html={example.shell} />
    </div>
    <p class="more"><a href={example.more.href}>{example.more.label}</a></p>
  </section>

  <section class="container sect last" aria-labelledby="paths">
    <h2 id="paths">{paths.heading}</h2>
    <ReaderGroups groups={paths.groups} />
    <div class="feedback"><Feedback /></div>
  </section>
</Base>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Opening: one column, the only thing in the first view that asks to be read first. */
  .opening {
    padding-block: 64px 32px;
  }
  .opening h1 {
    max-width: 32ch;
    margin-bottom: 28px;
    font-size: clamp(32px, 3.4vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .opening h1 .name {
    display: block;
  }
  .opening p {
    max-width: 62ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink);
  }
  .opening p + p {
    margin-top: 16px;
  }
  /* The plain reason sits between the formal title and the abstract, a step above body size. */
  .opening .dek {
    max-width: 34em;
    margin-bottom: 28px;
    font-size: 23px;
    line-height: 1.4;
    text-wrap: balance;
  }
  /* The scope sentence takes its own line, so the reason never wraps around it. */
  .dek .scope {
    display: block;
    color: var(--ink-3);
  }
  .opening .dek + p {
    margin-top: 0;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 32px;
    margin-top: 24px;
  }
  .next a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 17px;
    font-weight: 600;
  }

  /* Sections (.sect, .measure) come from global.css: a hairline with 32px either side, no boxes. */
  .lead {
    font-size: 18px;
    color: var(--ink-2);
  }

  /* The demo follows the abstract on the same left edge, close to the text width. */
  .demo .lead {
    margin-bottom: 24px;
  }
  .demo :global(.anatomy) {
    max-width: 800px;
  }
  .demo :global(.anatomy p) {
    margin: 0;
  }

  .core li a {
    font-weight: 600;
  }
  .core li p {
    margin-top: 4px;
    font-size: 16px;
    color: var(--ink-2);
  }

  /* Uses: examples, so an ordinary bulleted list; rules would make them read as records. */
  .uses {
    margin-block: 20px 24px;
    padding-left: 1.25em;
    list-style: disc;
  }
  .uses li {
    padding-block: 4px;
  }
  .uses li::marker {
    color: var(--ink-3);
  }

  /* Core: four rules, read as two pairs. */
  .core {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 56px;
    margin-top: 32px;
    font-variant-numeric: tabular-nums;
  }
  .core li {
    padding-block: 18px 22px;
    border-top: 1px solid var(--hair);
  }

  /* Example. */
  .codes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    max-width: 880px;
    margin-top: 32px;
  }
  .more,
  .core-after {
    margin-top: 24px;
  }

  .measure > p + p {
    margin-top: 12px;
  }
  /* The comments note under the reader groups: how to comment on the draft (the Feedback component). */
  .feedback {
    max-width: 68ch;
    margin-top: 32px;
    color: var(--ink-3);
  }

  @media (max-width: 720px) {
    .opening {
      padding-block: 40px 28px;
    }
    .opening p,
    .lead {
      font-size: 17px;
    }
    .opening .dek {
      margin-bottom: 20px;
      font-size: 20px;
    }
    .next {
      margin-top: 16px;
    }
    .core {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
