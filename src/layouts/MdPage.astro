---
import Docs from './Docs.astro';
/**
 * Adapter for Markdown/MDX pages: set `layout: ../layouts/MdPage.astro` in the frontmatter and
 * these fields map onto Docs.astro's props.
 *
 * Frontmatter: title, description, chips (list), section, editUrl, prev/next ({ label, href }),
 * asideLinks (list of { label, href }). `headings` comes from Astro.
 */
const { frontmatter, headings } = Astro.props;
---

<Docs
  title={frontmatter.title}
  description={frontmatter.description}
  chips={frontmatter.chips}
  section={frontmatter.section}
  editUrl={frontmatter.editUrl}
  prev={frontmatter.prev}
  next={frontmatter.next}
  asideLinks={frontmatter.asideLinks}
  headings={headings}
>
  <slot />
</Docs>
