---
import MethodTag from './MethodTag.astro';
/**
 * The resolution-walk figure: a request, then the path levels searched from the object up to the
 * root, with the level that answered highlighted. Used on "How it works".
 *
 * Props
 *   method   the HTTP method of the request
 *   object   the object path before the colon, e.g. "/animals/dogs/fido"
 *   verb     the verb name
 *   steps    [{ path, note, state }] in search order; state is "miss" | "hit" | "skipped".
 *            For a hit, `path` is the level that holds the definition.
 *   caption  figcaption text
 */
interface Step {
  path: string;
  note: string;
  state: 'miss' | 'hit' | 'skipped';
}
interface Props {
  method: string;
  object: string;
  verb: string;
  steps: Step[];
  caption?: string;
}
const { method, object, verb, steps, caption } = Astro.props;
---

<figure class="walk">
  <div class="req"><MethodTag method={method} /> {object}<span class="colon">:</span>{verb}</div>
  <ol>
    {
      steps.map((s, i) => (
        <li class={s.state}>
          <span class="n">{i + 1}</span>
          <span class="path">
            {s.state === 'hit' ? (
              <>
                {s.path}
                <span class="colon">:</span>
                {verb}
              </>
            ) : (
              s.path
            )}
          </span>
          <span class="note">{s.note}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .walk {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .req {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink);
    overflow-x: auto;
    white-space: nowrap;
  }
  .colon {
    color: var(--signal);
  }
  ol {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--surface-2);
    background: var(--ground);
    color: var(--ink-2);
  }
  li.hit {
    border: 1.5px solid var(--signal);
    background: var(--surface);
    color: var(--ink);
  }
  li.skipped {
    border: 1px dashed var(--line-strong);
    background: transparent;
    color: var(--ink-3);
  }
  .n {
    width: 20px;
    flex: none;
    color: var(--ink-3);
  }
  .hit .n {
    color: var(--signal);
    font-weight: 600;
  }
  .path {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .note {
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--ink-3);
    text-align: right;
  }
  .hit .note {
    color: var(--signal);
    font-weight: 500;
  }
  figcaption {
    font-size: 14px;
    color: var(--ink-3);
  }
  @media (max-width: 520px) {
    li {
      flex-wrap: wrap;
      gap: 2px 14px;
    }
    .note {
      flex: 1 0 100%;
      padding-left: 34px;
      text-align: left;
    }
  }
</style>
