---
/**
 * "In restactd": closes a protocol page with the pages of the restactd documentation that show how
 * the reference server implements what the page explains. The page writes the `## In restactd`
 * heading itself, so it gets an id and a place in "On this page"; this component renders the
 * sentence under it and the rows (link, then a one-line note), an untitled link group as in
 * ReaderGroups: one rule above, space between the rows.
 *
 * Props
 *   links  [{ label, href, body }], restactd documentation pages (RESTACTD_DOCS). In `body`,
 *          text between backticks is a path or identifier and renders in monospace.
 */
interface Link {
  label: string;
  href: string;
  body: string;
}
interface Props {
  links: Link[];
}
const { links } = Astro.props;
const parts = (s: string) => s.split('`').map((t, i) => ({ t, code: i % 2 === 1 }));
---

<div class="in-restactd">
  <p class="intro">
    How <a href="/restactd/">restactd</a>, the reference server, implements this, in its documentation:
  </p>
  <ul class="rows">
    {
      links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
          <p>{parts(l.body).map((x) => (x.code ? <code>{x.t}</code> : x.t))}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .in-restactd .intro {
    color: var(--ink-2);
  }
  .in-restactd .rows {
    margin: 16px 0 0;
    padding: 6px 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .in-restactd .rows li {
    margin: 0;
    padding-block: 10px;
  }
  .in-restactd .rows a {
    font-weight: 600;
  }
  .in-restactd .rows code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--ink);
  }
  .in-restactd .rows p {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
