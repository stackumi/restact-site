---
/**
 * The REST:ACT mark: a plane of four tiles; the two on the vertical axis have risen into a colon.
 * Colours come from the --mark-* tokens, so it re-colours with the theme.
 *
 * Props
 *   rise    play the rise once per visit (back tile, then the front one 60 ms later; later pages of the
 *           visit skip it, see Base.astro). Use it on the header mark only. It never plays under prefers-reduced-motion.
 *   height  rendered height in px (default 32, which is 40 wide). The full mark is for 40px and up.
 *   uid     suffix for the clipPath id. Give each Mark on a page a different one.
 */
interface Props {
  rise?: boolean;
  height?: number;
  uid?: string;
}
const { rise = false, height = 32, uid = 'a' } = Astro.props;
const clip = `restact-mark-clip-${uid}`;
---

<svg
  class:list={['mark', { rise }]}
  viewBox="6.6 12.3 50.8 40"
  height={height}
  width={(height * 50.8) / 40}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={clip} clipPathUnits="userSpaceOnUse"><rect x="32" y="0" width="40" height="64"></rect></clipPath>
  </defs>
  <rect class="place" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 26)"></rect>
  <rect class="tile" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 18 33)"></rect>
  <rect class="tile" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 46 33)"></rect>
  <rect class="place" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 40)"></rect>
  <g class="back">
    <rect class="wl" x="21.757" y="18" width="20.485" height="4"></rect>
    <rect class="wl" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 16)"></rect>
    <g clip-path={`url(#${clip})`}>
      <rect class="wr" x="21.757" y="18" width="20.485" height="4"></rect>
      <rect class="wr" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 16)"></rect>
    </g>
    <rect class="top" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 12)"></rect>
  </g>
  <g class="front">
    <rect class="wl" x="21.757" y="34" width="20.485" height="4"></rect>
    <rect class="wl" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 32)"></rect>
    <g clip-path={`url(#${clip})`}>
      <rect class="wr" x="21.757" y="34" width="20.485" height="4"></rect>
      <rect class="wr" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 32)"></rect>
    </g>
    <rect class="top" width="12" height="12" rx="3" transform="matrix(1 .5 -1 .5 32 28)"></rect>
  </g>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
  .tile {
    fill: var(--mark-tile);
    stroke: var(--mark-edge);
    stroke-width: 0.9;
  }
  .place {
    fill: none;
    stroke: var(--mark-dash);
    stroke-width: 1.2;
    stroke-dasharray: 1.6 1.6;
  }
  .wl {
    fill: var(--mark-wall-l);
  }
  .wr {
    fill: var(--mark-wall-r);
  }
  .top {
    fill: var(--mark-top);
  }
  /* The rise (identity doc, section 7): once, on first paint, never looping. */
  .rise .back {
    animation: rise-back 420ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms both;
  }
  .rise .front {
    animation: rise-front 420ms cubic-bezier(0.2, 0.8, 0.2, 1) 180ms both;
  }
  @keyframes rise-back {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
  @keyframes rise-front {
    from {
      transform: translateY(12px);
    }
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise .back,
    .rise .front {
      animation: none;
    }
  }
  /* Set by the head script in Base.astro once the rise has played in this visit. */
  :global(html.no-rise) .rise .back,
  :global(html.no-rise) .rise .front {
    animation: none;
  }
</style>
