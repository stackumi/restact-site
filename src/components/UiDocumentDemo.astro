---
import CodeBlock from './CodeBlock.astro';
import UiMock from './UiMock.astro';
import { viewJson } from '../lib/ui-example';
/** A UI document beside the screen a generic client draws from it. */

---

<div class="pair">
  <div class="json"><CodeBlock html={viewJson} copy={false} label="application/vnd.restact.ui+json" /></div>
  <div class="mock"><UiMock /></div>
</div>

<style>
  .pair { display: flex; flex-wrap: wrap; gap: 14px; margin: 1.4em 0; }
  .json { flex: 1 1 300px; min-width: 0; }
  .json :global(pre) { font-size: 12.5px; line-height: 1.65; }
  .json :global(.codeblock) { margin: 0; }
  .mock { flex: 1 1 240px; min-width: 0; display: flex; }
  .mock :global(.render) { flex: 1; }
</style>
