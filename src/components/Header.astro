---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, GITHUB } from '../site.config';
/**
 * Sticky, translucent site header. The DOM follows the visible desktop order (brand, nav, actions); the
 * menu button sits just before the nav so an open menu is the next Tab stop. The nav marks the current section with aria-current (a link is
 * current when the page path starts with its href). Below 880px the nav folds into a disclosure
 * button; without JavaScript it stays open as a wrapped row.
 *
 * Props
 *   wide  use the 1360px docs width instead of 1200px
 */
interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class:list={['bar', { wide }]}>
    <a class="brand" href="/" aria-label="REST:ACT home">
      <Mark rise uid="nav" />
      <Wordmark />
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" data-menu-toggle>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path class="open-icon" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="close-icon" d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <nav id="site-nav" class="nav" aria-label="Primary" data-site-nav>
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="cta cta-in-menu" href="/start/">Get started</a>
    </nav>
    <div class="actions">
      <a class="icon-link" href={GITHUB.specs} aria-label="GitHub: restact-specs">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a class="cta" href="/start/">Get started</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--hair);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .bar {
    max-width: calc(1200px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 12px var(--gutter);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
  .bar.wide {
    max-width: calc(1360px + 2 * var(--gutter));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .brand:hover {
    color: var(--ink);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    flex: 1 1 auto;
    font-size: 15px;
  }
  .nav a {
    color: var(--ink-2);
    padding: 10px 0;
    min-height: 44px;
    box-sizing: border-box;
  }
  .nav a:hover,
  .nav a[aria-current] {
    color: var(--ink);
  }
  .nav a[aria-current] {
    font-weight: 500;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    color: var(--ink-2);
  }
  .icon-link:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
  }
  .cta:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
  .cta-in-menu,
  .menu-toggle {
    display: none;
  }
  .menu-toggle {
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .menu-toggle:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .close-icon {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .close-icon {
    display: inline;
  }
  .menu-toggle[aria-expanded='true'] .open-icon {
    display: none;
  }

  @media (max-width: 879px) {
    .bar {
      position: relative;
      gap: 8px;
      justify-content: space-between;
    }
    .cta {
      display: none;
    }
    /* Without JS the nav stays open as a row under the brand. */
    .menu-toggle {
      order: 2;
    }
    .actions {
      order: 1;
      margin-left: auto;
    }
    .nav {
      order: 3;
      flex: 1 0 100%;
      gap: 0 18px;
    }
    :global(.js) .menu-toggle {
      display: inline-flex;
    }
    :global(.js) .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      border-bottom: 1px solid var(--hair);
      background: var(--ground);
    }
    :global(.js) .nav[data-open] {
      display: flex;
    }
    :global(.js) .nav a {
      padding: 12px 0;
      min-height: 44px;
      border-bottom: 1px solid var(--hair);
    }
    :global(.js) .nav .cta-in-menu {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 14px;
      padding: 0 16px;
      min-height: 44px;
      border: 1px solid var(--line-strong);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  if (toggle && nav) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      nav.toggleAttribute('data-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (toggle.getAttribute('aria-expanded') === 'true' && !nav.contains(t) && !toggle.contains(t)) set(false);
    });
  }
</script>
