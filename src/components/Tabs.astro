---
/**
 * ARIA tabs: real buttons, arrow keys/Home/End move and select, and the first panel shows without
 * JavaScript (the others carry `hidden` until the script reveals them).
 *
 * Props
 *   label  accessible name of the tab list, e.g. "Verb language"
 *   tabs   [{ id, label }]; each id names a slot that holds that panel's content
 *   id     unique per page; defaults to a slug of `label`
 *
 * Usage
 *   <Tabs label="Verb language" tabs={[{ id: 'js', label: 'JavaScript' }, ...]}>
 *     <Fragment slot="js"> ... </Fragment>
 *   </Tabs>
 * A panel may hold anything, including several CodeBlocks. Set `bare` for no outer frame.
 */
interface Props {
  label: string;
  tabs: { id: string; label: string }[];
  id?: string;
  bare?: boolean;
}
const { label, tabs, bare = false } = Astro.props;
const uid = Astro.props.id ?? label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class:list={['tabs', { bare }]} data-tabs>
  <div class="list" role="tablist" aria-label={label}>
    {
      tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${t.id}`}
          aria-controls={`${uid}-panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((t, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`${uid}-panel-${t.id}`}
        aria-labelledby={`${uid}-tab-${t.id}`}
        hidden={i !== 0}
      >
        <slot name={t.id} />
      </div>
    ))
  }
</div>

<style>
  .tabs {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--sunk);
    overflow: hidden;
  }
  .tabs.bare {
    border: 0;
    border-radius: 0;
    background: none;
    overflow: visible;
  }
  .list {
    display: flex;
    gap: 2px;
    padding: 6px;
    border-bottom: 1px solid var(--hair);
    background: var(--sunk-head);
    overflow-x: auto;
  }
  .bare .list {
    border: 1px solid var(--line);
    border-radius: 12px;
    margin-bottom: 12px;
  }
  button {
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: 9px;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 120ms ease, background-color 120ms ease;
  }
  button:hover {
    color: var(--ink);
  }
  button[aria-selected='true'] {
    background: var(--surface-2);
    border-color: var(--line-strong);
    color: var(--ink);
  }
  /* A CodeBlock inside a tab panel drops its own frame; the tab frame provides it. */
  .panel :global([data-codeblock]) {
    border: 0;
    border-radius: 0;
  }
  .panel :global([data-codeblock] + [data-codeblock]) {
    border-top: 1px solid var(--hair);
  }
  .bare .panel :global([data-codeblock]) {
    border: 1px solid var(--line);
    border-radius: 14px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const select = (next: HTMLButtonElement, focus: boolean) => {
      tabs.forEach((tab) => {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) next.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const to =
          e.key === 'ArrowRight' ? (i === last ? 0 : i + 1) :
          e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1) :
          e.key === 'Home' ? 0 :
          e.key === 'End' ? last : -1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to], true);
      });
    });
  });
</script>
