{
  "name": "restact-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "restact.org and restact.dev: the REST:ACT protocol site",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "sync:spec": "node scripts/sync-spec.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "check:content": "node scripts/check-site.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run check:content"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "7.4.7",
    "marked": "^18.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
